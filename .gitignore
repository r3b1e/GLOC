# Git tracks code, configs, docs, notebooks, figures, the demo, vector outlines and small
# text results (CSV/JSON). Large rasters, HDF5 files and model weights stay out of git:
# they are regenerated by ./run_pipeline.sh or shared separately (see "Getting the data and
# weights" in README.md). GitHub rejects files > 100 MB.

# ---- environment / tooling ----
.env/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
third_party/glavitu/
third_party/*.log

# ---- data: only small provenance files are tracked ----
data/**
!data/**/
!data/inventories/*.geojson
!data/inventories/chhota_shigri.gpkg
!data/inventories/grid.json
!data/sentinel2/selection_*.csv
!data/sentinel2/ensemble_*.csv
!data/sentinel2/ensemble_*.json
!data/sentinel2/scenes/*/scene.json
!data/sentinel1/*/scenes.json
!data/benchmark/tile_keys.json
!data/benchmark/nird_toc.csv
!data/benchmark/*_listing.json
!data/labels/pseudolabel_stats.json
!data/dem/dem_source.txt

# ---- models: weights are downloaded (pretrained) or shared separately (trained) ----
models/**/*.h5

# ---- experiments: keep metrics/configs/logs as text, drop rasters ----
experiments/**/*.tif
experiments/**/*.gpkg
experiments/**/scene_probs/

# ---- outputs: keep figures, statistics, vector outlines, small change maps ----
outputs/confidence/
outputs/masks/

# ---- scratch / temporary ----
scratch_models/
*.tmp
